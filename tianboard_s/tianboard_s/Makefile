link.cfg = cmsis-dap.cfg
OPENOCD = C:/Users/xixi/Downloads/xpack-openocd-0.12.0-6-win32-x64/xpack-openocd-0.12.0-6/bin/openocd.exe
#link.cfg = stlink.cfg
mcu.cfg = stm32f4x.cfg


flash:
	"$(OPENOCD)" -d1 \
		-f interface/$(link.cfg) \
		-f target/$(mcu.cfg) \
		-c "adapter speed 10000; program $(BUILD_DIR)/$(TARGET).elf verify reset exit"

reset:
	"openocd" -f interface/$(link.cfg) -f target/$(mcu.cfg) -c "init; reset run; exit"
