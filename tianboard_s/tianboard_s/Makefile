# Compile C source files
$(BUILD_DIR)/%.o: %.c Makefile Inc/version.h | $(BUILD_DIR)
	@echo "Compiling $(notdir $<)"
	@$(CC) -c $(CFLAGS) -Wa,-a,-ad,-alms=$(BUILD_DIR)/$(notdir $(<:.c=.lst)) $< -o $@

# Assemble ASM files
$(BUILD_DIR)/%.o: %.s Makefile | $(BUILD_DIR)
	@echo "Assembling $(notdir $<)"
	@$(AS) -c $(CFLAGS) $< -o $@

# Link ELF binary
$(BUILD_DIR)/$(TARGET).elf: $(OBJECTS) Makefile
	@echo "Linking $(TARGET).elf"
	@$(CC) $(OBJECTS) $(LDFLAGS) -o $@
	@$(SZ) $@

# Generate HEX
$(BUILD_DIR)/%.hex: $(BUILD_DIR)/%.elf | $(BUILD_DIR)
	@echo "Generating $@"
	@$(HEX) $< $@

# Generate BIN
$(BUILD_DIR)/%.bin: $(BUILD_DIR)/%.elf | $(BUILD_DIR)
	@echo "Generating $@"
	@$(BIN) $< $@

# Build directory
$(BUILD_DIR):
	@mkdir -p $@

Inc/version.h: FORCE
	@printf '#ifndef _VERSION_H_\n#define _VERSION_H_\n\n#define __GIT_COMMIT_ID__ "$(GIT_COMMIT_ID)"\n#define __FIRMWARE_VERSION__ "$(FW_VERSION)"\n\n#endif' > version.h.tmp
	@if [ -r Core/Inc/version.h ] && cmp -s Core/Inc/version.h version.h.tmp; then rm -f version.h.tmp;else : ;mv -f version.h.tmp Core/Inc/version.h; fi

FORCE:

# Show memory usage summary (for STM32F407IGHx)
show_size:
	@echo ""
	@echo "Memory Usage Summary (STM32F407IGHx):"
	@arm-none-eabi-size --format=berkeley $(BUILD_DIR)/$(TARGET).elf | awk 'NR==2{ \
		ram=$$2+$$3; flash=$$1+$$2; \
		printf "RAM:   %5d B / 196608 B (%.2f%%)\n", ram, ram/196608*100; \
		printf "FLASH: %5d B / 1048576 B (%.2f%%)\n", flash, flash/1048576*100; \
	}'

