[Unit]
Description=RM Autoaim Bringup
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
RemainAfterExit=yes
WorkingDirectory=/home/sunrise/rm_ws
Environment=REMOTE_WS=/home/sunrise/rm_ws
Environment=SERIAL_PORT=/dev/ttyS1
Environment=ENEMY_PREFIX=
ExecStart=/bin/bash /home/sunrise/rm_ws/src/scripts/clean_build_and_start_on_rdk.sh
ExecStop=/bin/bash -lc 'tmux kill-session -t rm_det 2>/dev/null || true; tmux kill-session -t rm_bridge 2>/dev/null || true; tmux kill-session -t hik_cam 2>/dev/null || true; pkill -f "rm_armor_detection rm_armor_detection" 2>/dev/null || true; pkill -f rm_gimbal_bridge_node 2>/dev/null || true; pkill -f hik_camera_node 2>/dev/null || true'
TimeoutStartSec=0

[Install]
WantedBy=default.target
