[Unit]
Description=RM Gimbal Bridge Bringup
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
RemainAfterExit=yes
WorkingDirectory=/home/sunrise/rm_ws
Environment=REMOTE_WS=/home/sunrise/rm_ws
Environment=REMOTE_SRC_DIR=/home/sunrise/rm_ws/src
Environment=REMOTE_SCRIPT_DIR=/home/sunrise/rm_ws/src/scripts
Environment=TMUX_SOCKET=bridge
Environment=SERIAL_PORT=/dev/serial/by-id/usb-Batmancris_Gimbal_Control_CDC_3162376B3439-if00
Environment=ENEMY_PREFIX=
Environment=BRIDGE_DELAY_SEC=4
Environment=WAIT_FOR_SERIAL_SEC=15
Environment=DETECTOR_READY_TIMEOUT_SEC=10
Environment=DETECTOR_TOPIC=/bear_detection/targets
Environment=ALLOWED_TARGET_TYPES=bear
Environment=BRIDGE_REQUIRE_VISION_ENABLED=true
Environment=BRIDGE_LOG_DIAG_FEEDBACK=false
Environment=BRIDGE_MIN_CONFIDENCE=0.71
Environment=ENABLE_FIXED_RATE_FOLLOW=true
Environment=FOLLOW_SEND_RATE_HZ=50.0
ExecStart=/bin/bash -lc 'exec "${REMOTE_SCRIPT_DIR}/start_rm_bridge_tmux.sh"'
ExecStop=/bin/bash -lc 'tmux -L bridge kill-session -t rm_bridge 2>/dev/null || true; pkill -f "[r]m_gimbal_bridge_node" 2>/dev/null || true'
TimeoutStartSec=0

[Install]
WantedBy=default.target
