[Unit]
Description=RM Autoaim Bringup (Camera + Detector)
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
RemainAfterExit=yes
WorkingDirectory=/home/sunrise/rm_ws
Environment=REMOTE_WS=/home/sunrise/rm_ws
Environment=REMOTE_SRC_DIR=/home/sunrise/rm_ws/src
Environment=REMOTE_SCRIPT_DIR=/home/sunrise/rm_ws/src/scripts
Environment=STARTUP_DELAY_SEC=2
Environment=DETECTOR_DELAY_SEC=0
Environment=CAMERA_READY_TIMEOUT_SEC=8
Environment=TMUX_SOCKET=autoaim
Environment=DETECTOR_TYPE=bear
Environment=DETECTOR_TOPIC=/bear_detection/targets
Environment=ENABLE_VISUALIZER=false
Environment=DISPLAY_VALUE=:0
Environment=XAUTHORITY_VALUE=/home/sunrise/.Xauthority
Environment=XDG_RUNTIME_DIR_VALUE=/run/user/1000
Environment=VIS_DELAY_SEC=3
Environment=VIS_MAX_FPS=24.0
Environment=VIS_SCALE=1.0
Environment=VIS_DEBUG_TOPIC=/bear_detection/debug_text
Environment=VIS_SHOW_DEBUG_TEXT=false
Environment=VIS_FULLSCREEN=false
Environment=VIS_KEEP_ASPECT_RATIO=true
Environment=VIS_WINDOW_WIDTH=1920
Environment=VIS_WINDOW_HEIGHT=1080
Environment=VEHICLE_PUBLISH_DEBUG_TEXT=false
Environment=VEHICLE_LOG_LEVEL=warn
Environment=BEAR_LOG_LEVEL=warn
Environment=BEAR_SCORE_THRESHOLD=0.71
Environment=BEAR_STABLE_REQUIRED_HITS=2
Environment=BEAR_STABLE_MATCH_RADIUS_PX=140.0
Environment=BEAR_STABLE_MAX_TRACK_AGE_MS=200
Environment=BEAR_PUBLISH_DEBUG_TEXT=false
Environment=BEAR_LOG_DETECTIONS=false
ExecStart=/bin/bash -lc 'exec "${REMOTE_SCRIPT_DIR}/start_autoaim_tmux.sh"'
ExecStop=/bin/bash -lc 'tmux -L autoaim kill-session -t rm_det 2>/dev/null || true; tmux -L autoaim kill-session -t hik_cam 2>/dev/null || true; tmux -L autoaim kill-session -t rm_vis 2>/dev/null || true; pkill -f "[r]m_armor_detection rm_armor_detection" 2>/dev/null || true; pkill -f "[r]m_vehicle_detection rm_vehicle_detection_node" 2>/dev/null || true; pkill -f "[r]m_bear_detection rm_bear_detection_node" 2>/dev/null || true; pkill -f "[h]ik_camera_node" 2>/dev/null || true'
TimeoutStartSec=0

[Install]
WantedBy=default.target
