[Unit]
Description=RM Autoaim Bringup (Camera + Detector)
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
RemainAfterExit=yes
WorkingDirectory=/home/sunrise/rm_ws
Environment=REMOTE_WS=/home/sunrise/rm_ws
Environment=REMOTE_SRC_DIR=/home/sunrise/rm_ws/src
Environment=REMOTE_SCRIPT_DIR=/home/sunrise/rm_ws/src/scripts
Environment=STARTUP_DELAY_SEC=2
Environment=DETECTOR_DELAY_SEC=0
Environment=CAMERA_READY_TIMEOUT_SEC=8
Environment=TMUX_SOCKET=autoaim
Environment=DISPLAY_VALUE=:0
Environment=XAUTHORITY_VALUE=/home/sunrise/.Xauthority
Environment=XDG_RUNTIME_DIR_VALUE=/run/user/1000
Environment=VIS_DELAY_SEC=3
ExecStart=/bin/bash -lc 'exec "${REMOTE_SCRIPT_DIR}/start_autoaim_tmux.sh"'
ExecStop=/bin/bash -lc 'tmux -L autoaim kill-session -t rm_det 2>/dev/null || true; tmux -L autoaim kill-session -t hik_cam 2>/dev/null || true; tmux -L autoaim kill-session -t rm_vis 2>/dev/null || true; pkill -f "rm_armor_detection rm_armor_detection" 2>/dev/null || true; pkill -f hik_camera_node 2>/dev/null || true'
TimeoutStartSec=0

[Install]
WantedBy=default.target
